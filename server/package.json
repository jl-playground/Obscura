{
  "name": "Obscura-Backend",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "serve": "tsx watch index.ts",
    "build": "tsc && tsc-alias && cp -R src/core/database/config dist/src/core/database/",
    "serve-production": "node dist/index.js",
    "production": "pm2 start process.yml",
    "test": "eslint --ext .ts src/",
    "lint": "eslint --fix --ext .ts .",
    "format": "prettier-eslint \"src/**/*.{js,ts} \"  --write",
    "db-migrate": "sequelize db:migrate",
    "db-seed": "sequelize db:seed:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.458.0",
    "@aws-sdk/lib-storage": "^3.667.0",
    "@sentry/node": "^7.81.1",
    "@socket.io/cluster-adapter": "^0.2.2",
    "@socket.io/sticky": "^1.0.4",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "globals": "^16.5.0",
    "graphql": "^16.8.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-require-context": "^1.0.0",
    "nodemailer": "^6.9.7",
    "nodemailer-express-handlebars": "^6.1.0",
    "pg": "^8.11.3",
    "redis": "^5.10.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.7.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.2",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-extended": "^2.3.3",
    "eslint-config-node": "^4.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "nodemon": "^3.0.1",
    "prettier": "^3.7.4",
    "prettier-eslint-cli": "^8.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
