<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <style
    > Import Fonts */ @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap"); @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"); Reset & Base Styles */ body { margin: 0; padding: 0; background-color: #fafafa; font-family: "Inter", sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; } table { border-spacing: 0; border-collapse: collapse; } td { padding: 0; } img { border: 0; display: block; line-height: 100%; outline: none; text-decoration: none; } Responsive Styles */ @media screen and (max-width: 600px) { .main-table { width: 100% !important; }
        .wrapper {
          padding-left: 10px !important;
          padding-right: 10px !important;
        }
        .body-padding {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #FAFAFA;">

    <!-- Wrapper -->
    <table
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #FAFAFA;"
      class="wrapper"
    >
      <tr>
        <td align="center" style="padding-top: 40px; padding-bottom: 40px;">

          <!-- Main Card -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="max-width: 600px; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; box-shadow: 0px 4px 12px rgba(0,0,0,0.05);"
            class="main-table"
          >

            <!-- Spacer -->
            <tr><td
                height="40"
                style="font-size: 40px; line-height: 40px;"
              >&nbsp;</td></tr>

            <!-- Icon -->
            <tr>
              <td align="center">
                <img
                  src="https://img.icons8.com/ios-filled/100/38265C/lock.png"
                  alt="Secure"
                  width="60"
                  style="width: 60px; height: auto; display: block;"
                />
              </td>
            </tr>

            <!-- Heading -->
            <tr>
              <td
                align="center"
                style="padding-top: 20px; font-family: 'Poppins', sans-serif; font-size: 24px; font-weight: 600; color: #38265C;"
              >
                Reset Password
              </td>
            </tr>

            <!-- Body Text -->
            <tr>
              <td
                class="body-padding"
                style="padding: 20px 40px; font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.5; color: #1B1B1B;"
              >
                Hello
                {{username}},
                <br /><br />
                We received a request to reset the password for your
                <b>ObscuraMatch</b>
                account. If you didn't make this request, you can safely ignore
                this email.
              </td>
            </tr>

            <!-- Button -->
            <tr>
              <td align="center" style="padding-bottom: 20px;">
                <table border="0" cellspacing="0" cellpadding="0">
                  <tr>
                    <td
                      align="center"
                      bgcolor="#38265C"
                      style="border-radius: 12px;"
                    >
                      <a
                        href="{{{resetLink}}}"
                        target="_blank"
                        style="font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; color: #FFFFFF; background-color: #38265C; border-radius: 12px; padding: 12px 24px; display: inline-block; text-decoration: none; border: 1px solid #38265C;"
                      >
                        Reset My Password
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Fallback Link -->
            <tr>
              <td
                align="center"
                class="body-padding"
                style="padding: 20px 40px 40px 40px; font-family: 'Inter', sans-serif; font-size: 12px; line-height: 1.5; color: #666666;"
              >
                Button not working? Open this link on your mobile device:<br />
                <a
                  href="{{{resetLink}}}"
                  style="color: #F57F69; text-decoration: none; font-weight: 600;"
                >
                  {{{resetLink}}}
                </a>
              </td>
            </tr>
          </table>
          <!-- End Main Card -->

          <!-- Footer -->
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="max-width: 600px; margin-top: 20px;"
          >
            <tr>
              <td
                align="center"
                style="font-family: 'Inter', sans-serif; font-size: 14px; color: #666666;"
              >
                © 2025 Obscura App. All rights reserved.
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>

  </body>
</html>
