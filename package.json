{
  "name": "obscura",
  "version": "0.1.0",
  "description": "A Reverse Blind dating expirence",
  "main": "index.ts",
  "author": "Joel Leimbacher",
  "organization": "jl-playground",
  "license": "Non-Commercial",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "bun run --watch index.ts",
    "migration:generate": "tsx node_modules/.bin/typeorm migration:generate src/core/db/migrations/$npm_config_name -d src/core/db/dataSource.ts",
    "migration:create": "tsx node_modules/.bin/typeorm migration:create src/core/db/migrations/InitialSchema",
    "migration:run": "tsx node_modules/.bin/typeorm migration:run -d src/core/db/dataSource.ts",
    "migration:revert": "tsx node_modules/.bin/typeorm migration:revert -d src/core/db/dataSource.ts",
    "migration:drop": "tsx node_modules/.bin/typeorm schema:drop -d src/core/db/dataSource.ts",
    "migration:resetDb": "bun run migration:drop && bun run migration:create && bun run migration:run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "elysia": "latest",
    "handlebars": "^4.7.8",
    "jiti": "^2.6.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "pg": "latest",
    "reflect-metadata": "^0.2.2",
    "sequelize": "latest",
    "tsx": "^4.20.6",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.52.0",
    "@types/jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
